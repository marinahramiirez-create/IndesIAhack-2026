# Copia este archivo como .env y rellénalo. El .env NUNCA se sube a git.
# Los valores están en el PDF "KEYS Y ENDPOINTS DE LOS RECURSOS COMUNES" del canal de Teams.

# Clave y endpoint de la plataforma IndesIA (modelos Claude)
AZURE_API_KEY=
ANTHROPIC_BASE_URL=

# Modelo pequeño para lo simple y grande para razonar
MODELO_RAPIDO=
MODELO_AUDITOR=

# Opcional: ruta a la carpeta con los PDF del corpus si no está en la raíz del repositorio
# CORPUS_NIMBUS=C:\ruta\a\03_corpus_trabajo_NIMBUS\03_corpus_trabajo_NIMBUS
