# Copia este archivo como .env y rellena lo que toque. NUNCA subas el .env a git.

# --- Base de datos ---
# Local (por defecto si se deja comentado): sqlite en datos/airbus.db
# Azure PostgreSQL:
# DATABASE_URL=postgresql+psycopg://USUARIO:CLAVE@SERVIDOR.postgres.database.azure.com:5432/airbus?sslmode=require

# --- Inicio de sesión (ver AUTENTICACION.md) ---
# true = pantalla de login (por defecto) · false = sin login, para una demo rápida
# AUTH_ACTIVADA=true
# true = PROTOTIPO: cualquier usuario y contraseña entra (por defecto). false = se comprueban de verdad
# AUTH_PROTOTIPO=true

# --- Entradas (el día del reto) ---
# DIR_DATOS=C:/ruta/a/los/datos_del_reto
# DOCUMENTO=nombre_del_documento.docx      (.docx, .pdf, .md o .txt)
# GOLD=gold.csv                            (columnas: req_id, veredicto_gold, clausula_gold)
# PATRON_ID_REQUISITO=\b(?:REQ|SR|SEC|IS)-\d{2,4}\b

# --- Parámetros de la auditoría ---
# TOP_K=4
# TOP_K_LLM=6
# JUICIOS_AUTOCONSISTENCIA=3
# UMBRAL_CONFIANZA=0.6
# MAX_REFLEXIONES=1

# --- LLM (opcional): ninguno | azure | openai ---
# Valores del PDF del canal general de Teams (enlaces a 1Password). Pon LLM_PROVEEDOR=azure para activarlo.
LLM_PROVEEDOR=ninguno
AZURE_OPENAI_ENDPOINT=https://NOMBRE.openai.azure.com/
AZURE_OPENAI_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
# Nombre del DESPLIEGUE (no del modelo): se ve en Azure AI Foundry → Deployments
AZURE_OPENAI_DEPLOYMENT=
# Nombre del despliegue de embeddings (activa la búsqueda híbrida BM25 + vectores)
AZURE_OPENAI_EMBEDDINGS=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Azure AI Search (opcional: hoy se usa BM25 local) ---
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=

# --- Databricks (opcional: para ejecutar el pipeline en el clúster o leer el volumen) ---
# Host: la URL del workspace, p. ej. https://adb-1234567890.12.azuredatabricks.net
DATABRICKS_HOST=
# Token personal: Databricks → tu usuario (arriba a la derecha) → Settings → Developer → Access tokens
DATABRICKS_TOKEN=
# Catálogo del equipo (p. ej. dat_hack_en01) → datos en /Volumes/<catalogo>/raw_sch/raw_vol/datos_reto/
DATABRICKS_CATALOGO=

# --- Reto NIMBUS (nimbus/) ---
# Carpeta del kit de desarrollo (clave + puntuador). NUNCA se sube a git.
# NIMBUS_KIT=C:/ruta/a/06_kit_desarrollo_equipos/06_kit_desarrollo_equipos
