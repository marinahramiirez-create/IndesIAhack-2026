# Copia este archivo como .env y rellena lo que toque. NUNCA subas el .env a git.

# --- Base de datos ---
# Local (por defecto si se deja comentado): sqlite en datos/acerinox.db
# DATABASE_URL=postgresql+psycopg://USUARIO:CLAVE@SERVIDOR.postgres.database.azure.com:5432/acerinox?sslmode=require

# --- Entradas (el día del reto) ---
# DIR_DATOS=C:/ruta/a/los/datos_del_reto
# STOCK=stock.csv
# CATALOGO=catalogo.pdf        (.pdf, .md o .txt)
# REGLAS=reglas_transformacion.txt

# --- Reglas de negocio ---
# TOLERANCIA_ESPESOR_MM=0.02
# FACTOR_BULTO_GRANDE=3
# MAX_PROPUESTAS=3

# --- LLM y voz (opcional): ninguno | azure | openai ---
LLM_PROVEEDOR=ninguno
AZURE_OPENAI_ENDPOINT=https://NOMBRE.openai.azure.com/
AZURE_OPENAI_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=
# Despliegue de Whisper para voz → texto
AZURE_OPENAI_WHISPER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
