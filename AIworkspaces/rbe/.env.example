# Copia este archivo como .env y rellena lo que toque.
# NUNCA subas el .env a git.

# --- Base de datos ---
# Local (por defecto, si se deja comentado):
# DATABASE_URL=sqlite:///datos/rbe.db
# Azure PostgreSQL:
# DATABASE_URL=postgresql+psycopg://USUARIO:CLAVE@SERVIDOR.postgres.database.azure.com:5432/rbe?sslmode=require

# --- Carpeta con los CSV de entrada ---
# DIR_DATOS=C:/ruta/a/datos_reales

# --- LLM (opcional): ninguno | azure | openai ---
LLM_PROVEEDOR=ninguno
AZURE_OPENAI_ENDPOINT=https://NOMBRE.openai.azure.com/
AZURE_OPENAI_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
